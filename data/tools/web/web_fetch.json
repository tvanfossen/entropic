{
  "name": "web_fetch",
  "description": "PLACEHOLDER — not implemented. No HTTP client is wired; every call returns the `not_implemented` error. Disabled by default (mcp.enable_web).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "URL to fetch"
      },
      "max_length": {
        "type": "integer",
        "description": "Maximum content length in characters (default: 20000)",
        "default": 20000
      }
    },
    "required": [
      "url"
    ]
  },
  "outputSchema": {
    "title": "error",
    "type": "object",
    "required": [
      "error",
      "message"
    ],
    "properties": {
      "error": {
        "enum": [
          "not_implemented"
        ]
      },
      "message": {
        "type": "string"
      }
    }
  }
}
