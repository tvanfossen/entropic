{
  "name": "write_file",
  "description": "Create a new file or fully overwrite an existing file. Parent directories are created.\n\n**Requirements:**\n- If the file EXISTS: you must read it first (else `read_before_write`)\n- If the file is NEW: create it directly\n\n**When to use:** new files; major rewrites (>50% of the content); splitting a file; when edit_file keeps failing with `no_match`. For partial changes use edit_file.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Path to the file"
      },
      "content": {
        "type": "string",
        "description": "Full file content"
      }
    },
    "required": [
      "path",
      "content"
    ]
  },
  "outputSchema": {
    "oneOf": [
      {
        "title": "success",
        "type": "object",
        "required": [
          "path",
          "bytes_written",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes_written": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      {
        "title": "error",
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "enum": [
              "read_before_write"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    ]
  }
}
