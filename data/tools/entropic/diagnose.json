{
  "name": "diagnose",
  "description": "Get a complete snapshot of engine state for self-diagnosis. Returns current configuration, loaded identities, available tools, recent tool call history, engine state, and metrics. Use this when you need to understand why something went wrong or to verify engine state before taking action.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "include_docs": {
        "type": "boolean",
        "description": "Include bundled architecture documentation in the snapshot. Default false to save context space.",
        "default": false
      },
      "history_limit": {
        "type": "integer",
        "description": "Maximum number of recent tool call history entries to include. Default 20.",
        "default": 20
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "oneOf": [
      {
        "title": "snapshot",
        "type": "object",
        "required": [
          "snapshot_timestamp_ms",
          "engine",
          "config",
          "identities",
          "tools",
          "history",
          "metrics",
          "docs"
        ],
        "properties": {
          "snapshot_timestamp_ms": {
            "type": "integer"
          },
          "engine": {
            "type": "object",
            "additionalProperties": true,
            "description": "the same object as inspect target `state`"
          },
          "config": {
            "type": "object",
            "additionalProperties": true,
            "description": "the active configuration, by section"
          },
          "identities": {
            "type": [
              "object",
              "array"
            ],
            "description": "loaded identities"
          },
          "tools": {
            "type": [
              "object",
              "array"
            ],
            "description": "registered tools"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "content_preview",
                "token_count_est"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "content_preview": {
                  "type": "string"
                },
                "token_count_est": {
                  "type": "integer"
                }
              }
            },
            "description": "the most recent context messages; previews over 200 bytes end in `...`"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": true,
            "description": "engine counters"
          },
          "docs": {
            "type": [
              "string",
              "null"
            ],
            "description": "bundled documentation when include_docs is true, else null"
          }
        }
      },
      {
        "title": "error",
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "enum": [
              "provider_unavailable"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    ]
  }
}
