{
  "name": "glob",
  "description": "Find files whose path (relative to the project root) matches a glob pattern. Files excluded by .gitignore/.explorerignore are skipped. `{a,b}` alternatives are supported.\n\n**Example patterns:**\n- `**/*.py` — all Python files\n- `src/**/*.md` — Markdown under src/\n- `*.json` — JSON files in the project root\n- `tests/**/test_*.py` — test files",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pattern": {
        "type": "string",
        "description": "Glob pattern (e.g. '**/*.py', 'src/**/*.md', '*.json')"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "description": "Maximum paths to return (default 500, max 5000)"
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "description": "Number of paths to skip, from a previous next_offset (default 0)"
      }
    },
    "required": [
      "pattern"
    ]
  },
  "outputSchema": {
    "oneOf": [
      {
        "title": "success",
        "type": "object",
        "required": [
          "paths",
          "truncated"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "matching files, relative to the project root, in walk order"
          },
          "truncated": {
            "type": "boolean",
            "description": "true = partial answer"
          },
          "reason": {
            "enum": [
              "limit",
              "walk"
            ],
            "description": "`limit`: more exist, continue at next_offset; `walk`: walk cap hit, narrow the search"
          },
          "next_offset": {
            "type": "integer",
            "description": "the `offset` for the next page"
          }
        }
      },
      {
        "title": "error",
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "enum": [
              "invalid_args"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    ]
  }
}
