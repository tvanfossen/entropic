{
  "name": "context_inspect",
  "description": "Inspect the current conversation context. Returns each message with its role, a content preview, and an estimated token count. Use this to understand what is in the context window, how many tokens each message occupies, and whether compaction is needed.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "max_messages": {
        "type": "integer",
        "description": "Maximum number of most-recent messages to return. 0 or omitted returns all messages.",
        "minimum": 0
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "oneOf": [
      {
        "title": "success",
        "type": "object",
        "required": [
          "messages"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "content_preview",
                "token_count_est"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "content_preview": {
                  "type": "string",
                  "description": "the first 200 bytes, followed by `...` when longer"
                },
                "token_count_est": {
                  "type": "integer",
                  "description": "content bytes / 4"
                }
              }
            },
            "description": "oldest first"
          }
        }
      },
      {
        "title": "error",
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "enum": [
              "provider_unavailable"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    ]
  }
}
