{
  "name": "branch",
  "description": "List or create git branches.\n\n**Examples:**\n- List branches: `{}`\n- Create branch: `{\"name\": \"feature/new-feature\"}`",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Branch name to create (omit to list)"
      }
    },
    "required": []
  },
  "outputSchema": {
    "oneOf": [
      {
        "title": "success",
        "type": "object",
        "required": [
          "exit_code",
          "output"
        ],
        "properties": {
          "exit_code": {
            "type": "integer",
            "description": "0 ok; non-zero: git failed, see output; -1: git did not start"
          },
          "output": {
            "type": "string"
          }
        }
      },
      {
        "title": "error",
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "enum": [
              "invalid_args"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    ]
  }
}
